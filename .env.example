# Project Kriya — environment contract.
#
# NAMES ONLY. NEVER VALUES. Copy to .env (which is gitignored) and fill in.
#   cp .env.example .env
#
# This file is the only place that says what `pulse` and the platform expect from their
# environment. It is committed; `.env` never is. Every variable is added on the day it is first
# used and carries that day in a comment — an unexplained variable here is a bug (Principle 9).
#
# Everything below is free. No card on file, for anything, ever (Addendum 01).

# ─────────────────────────────────────────────────────────────────────────────
# Day 3 — `pulse`, the service you operate for the whole curriculum
# ─────────────────────────────────────────────────────────────────────────────
PULSE_ENV=                       # local | ci | staging | prod  (Day 10)
PULSE_PORT=
PULSE_LOG_LEVEL=                 # debug | info | warning | error  (Day 67)
PULSE_LOG_FORMAT=                # json in every environment except your terminal (Day 67)

# ─────────────────────────────────────────────────────────────────────────────
# Day 9 — the three free model doors. Created in a browser, no card on any of them.
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE  # TRUE would route to a billed project. Never flip this.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Day 126 — the local model lane, so the curriculum survives a dead free tier
# ─────────────────────────────────────────────────────────────────────────────
OLLAMA_HOST=                     # http://localhost:11434
PULSE_LLM_PRIMARY=               # provider/model, looked up live on the day (never invented)
PULSE_LLM_FALLBACK=              # Day 130 — the second door, for when the first has a bad day

# ─────────────────────────────────────────────────────────────────────────────
# Day 87 — data and Day 98 — experiment tracking / the model registry
# ─────────────────────────────────────────────────────────────────────────────
DATA_REMOTE=                     # a local path on Day 87; an object store only if it is free
MLFLOW_TRACKING_URI=             # http://localhost:5000 — a local server, not a hosted plan
MLFLOW_REGISTRY_URI=
PULSE_MODEL_NAME=                # the registered name, not a file path (Day 99)
PULSE_MODEL_STAGE=               # none | staging | production  (Day 99)

# ─────────────────────────────────────────────────────────────────────────────
# Day 64 / Day 69 — telemetry. One collector endpoint, everything speaks to it.
# ─────────────────────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=     # http://localhost:4317
OTEL_TRACES_SAMPLER=             # Day 70 — sampling is a cost decision, so it is configuration
OTEL_RESOURCE_ATTRIBUTES=        # service.version, deployment.environment — set, never guessed

# ─────────────────────────────────────────────────────────────────────────────
# Day 62 / Day 66 / Day 68 — the local observability stack (compose, then the cluster)
# ─────────────────────────────────────────────────────────────────────────────
PROMETHEUS_URL=
GRAFANA_URL=
GRAFANA_ADMIN_PASSWORD=          # a real secret even though it is only your laptop
LOKI_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Day 95 — state that outlives a container
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=                    # postgresql://user:pass@host:5432/pulse — one URL, not five vars
QDRANT_URL=                      # Day 140 — the vector store, once retrieval exists

# ─────────────────────────────────────────────────────────────────────────────
# Day 32 / Day 56 — the cluster and the thing that reconciles it
# ─────────────────────────────────────────────────────────────────────────────
KUBECONFIG=                      # point at the kind config only. Never at a shared cluster.
KIND_CLUSTER_NAME=
ARGOCD_SERVER=

# ─────────────────────────────────────────────────────────────────────────────
# Day 27 — where images live
# ─────────────────────────────────────────────────────────────────────────────
REGISTRY=                        # ghcr.io/<you> — free for public images
IMAGE_TAG=                       # set by CI from the commit sha. Never `latest` (Day 27).

# ─────────────────────────────────────────────────────────────────────────────
# Day 203 / Day 208 — the MCP boundary
# ─────────────────────────────────────────────────────────────────────────────
MCP_SERVER_URL=
MCP_SERVER_TOKEN=                # rotate this the way Day 9 taught you to rotate a key
MCP_ALLOWED_TOOLS=               # a comma-separated allowlist. Empty means none, not all.

# ─────────────────────────────────────────────────────────────────────────────
# Day 188 / Day 194 — the brakes on anything that acts on its own
# ─────────────────────────────────────────────────────────────────────────────
AGENT_MAX_STEPS=                 # a hard cap. There is no "unlimited" setting for a reason.
AGENT_DAILY_CALL_BUDGET=         # quota is the currency (Principle 15)
AGENT_ACTION_TIER=               # read | suggest | act_with_approval | act  (Day 194)
AGENT_KILL_SWITCH=               # on | off — Day 188 tests that it actually works
